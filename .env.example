# Bug Intake Automation - Environment Variables
# Copy this file to .env and fill in your actual API tokens

# Intercom API Token
# Get this from: https://app.intercom.com/a/settings/personal-apps/
# Must have read/write access to conversations
INTERCOM_API_TOKEN=your_intercom_api_token_here

# Linear API Token
# Get this from: https://linear.app/settings/api
# Must have permission to create comments
LINEAR_API_TOKEN=your_linear_api_token_here
